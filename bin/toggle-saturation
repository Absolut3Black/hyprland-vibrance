#!/usr/bin/env bash
# ==============================================================================
# toggle-saturation: Toggle or set Hyprland screen saturation/vibrance shader
# Compatible with Omarchy (Lua) and standard Hyprland (hyprland.conf)
# ==============================================================================

SHADER="${HYPR_SHADER_PATH:-$HOME/.config/hypr/shaders/saturation.glsl}"

get_current_shader() {
  local output
  output=$(hyprctl getoption decoration:screen_shader -j 2>/dev/null | jq -r '.str // empty' 2>/dev/null)
  if [[ "$output" == "[[EMPTY]]" || "$output" == '""' || -z "$output" ]]; then
    echo ""
  else
    echo "$output"
  fi
}

apply_shader() {
  local target="$1"
  # Try Lua eval first (Omarchy / Hyprland >= 0.50 Lua)
  local res
  res=$(hyprctl eval "hl.config({ decoration = { screen_shader = \"$target\" } })" 2>/dev/null)
  if [[ "$res" != *"ok"* ]]; then
    # Fallback to keyword for standard hyprland.conf
    hyprctl keyword decoration:screen_shader "$target" >/dev/null 2>&1
  fi
}

enable_shader() {
  if [[ ! -f "$SHADER" ]]; then
    if command -v notify-send >/dev/null 2>&1; then
      notify-send -a "Display" -u critical "Saturation Error" "Shader not found: $SHADER"
    fi
    echo "Error: Shader not found at $SHADER" >&2
    exit 1
  fi

  apply_shader "$SHADER"

  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Display" -i video-display "Color Vibrance" "Boost Enabled (+30% Saturation & Vibrance)"
  fi
  echo "Saturation shader enabled: $SHADER"
}

disable_shader() {
  apply_shader ""

  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Display" -i video-display "Color Vibrance" "Boost Disabled (Neutral)"
  fi
  echo "Saturation shader disabled."
}

toggle_shader() {
  local current
  current=$(get_current_shader)
  if [[ -n "$current" ]]; then
    disable_shader
  else
    enable_shader
  fi
}

status() {
  local current
  current=$(get_current_shader)
  if [[ -n "$current" ]]; then
    echo '{"enabled": true, "shader": "'"$current"'"}'
  else
    echo '{"enabled": false, "shader": null}'
  fi
}

case "${1:-toggle}" in
  on|enable|--on|--enable)
    enable_shader
    ;;
  off|disable|--off|--disable)
    disable_shader
    ;;
  status|--status)
    status
    ;;
  toggle|--toggle)
    toggle_shader
    ;;
  help|-h|--help)
    echo "Usage: $(basename "$0") [on|off|toggle|status]"
    echo ""
    echo "Commands:"
    echo "  toggle   Toggle shader on/off (default)"
    echo "  on       Enable shader"
    echo "  off      Disable shader"
    echo "  status   Output JSON status"
    ;;
  *)
    toggle_shader
    ;;
esac
